enum BugStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model BugReport {
  id         String  @id @default(uuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  reporterId String
  reporter   User    @relation("BugReports", fields: [reporterId], references: [id])

  summary     String
  description String?

  screenshotPath   String
  screenshotWidth  Int
  screenshotHeight Int

  pageUrl        String
  viewportWidth  Int
  viewportHeight Int
  userAgent      String
  osName         String?
  osVersion      String?
  browserName    String?
  browserVersion String?
  deviceType     String?
  appBuildSha    String?

  status       BugStatus    @default(NEW)
  priority     BugPriority?
  assignedToId String?
  assignedTo   User?        @relation("AssignedBugs", fields: [assignedToId], references: [id])
  reporterLastReadAt DateTime?

  comments      BugReportComment[]
  statusChanges BugReportStatusChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([reporterId, createdAt(sort: Desc)])
}

model BugReportComment {
  id          String    @id @default(uuid())
  bugReportId String
  bugReport   BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("BugComments", fields: [authorId], references: [id])
  body        String
  imageUrl    String?
  createdAt   DateTime  @default(now())

  @@index([bugReportId, createdAt])
}

model BugReportStatusChange {
  id          String     @id @default(uuid())
  bugReportId String
  bugReport   BugReport  @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User       @relation("BugStatusChanges", fields: [changedById], references: [id])
  fromStatus  BugStatus?
  toStatus    BugStatus
  note        String?
  createdAt   DateTime   @default(now())

  @@index([bugReportId, createdAt])
}
